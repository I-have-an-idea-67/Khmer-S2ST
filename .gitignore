# ============================================================================
# STAGE 07 - Git Hygiene
# Heavy data, checkpoints, and build artifacts must never be tracked.
# ============================================================================

# --- Python virtual environments -------------------------------------------
.venv/
.env
*.env
.env.*
venv/
.env
*.env
.env.*
env/
.env
*.env
.env.*

# --- Python bytecode / caches ----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- Rust / Cargo build artifacts ------------------------------------------
target/
**/*.rs.bk

# --- Node / frontend --------------------------------------------------------
node_modules/
dist/
build/
.vite/

# --- Model checkpoints and weights ------------------------------------------
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.engine
*.plan

# --- Datasets and media -----------------------------------------------------
data/
*.wav
*.flac
*.mp3
*.ogg
*.m4a
*.Parquet
*.parquet
*.arrow
*.jsonl
*.tsv

# --- Logs / temp ------------------------------------------------------------
*.log
*.tmp
*.temp
.cache/
tmp/

# --- Rust Python extension artifacts (built locally) ------------------------
*.pyd
*.so
*.dylib

# --- Editor / OS ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
